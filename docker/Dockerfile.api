# Build stage
FROM golang:1.25-alpine AS builder

# Install build dependencies
RUN apk add --no-cache \
    gcc \
    musl-dev \
    git

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY internal/ ./internal/
COPY scripts/ ./scripts/
RUN go build -v -o server ./internal/server.go

# Final stage
FROM alpine:latest

# Install runtime dependencies INCLUDING PYTHON
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    shadow \
    python3 \
    py3-pip \
    wget \
    && update-ca-certificates

# Install docx2txt directly in final stage
RUN pip3 install --break-system-packages --no-cache-dir docx2txt pypdf

# Create non-root user and directories
RUN groupadd -r app && useradd -r -g app app \
    && mkdir -p /app/data /app/logs /app/uploads \
    && chown -R app:app /app

WORKDIR /app

# Copy the binary and scripts
COPY --from=builder --chown=app:app /app/server .
COPY --from=builder --chown=app:app /app/scripts ./scripts/

USER app
EXPOSE 3000 6334 9000

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/health || exit 1

CMD ["./server"]